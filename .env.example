# Optional overrides, read by both `make` and `docker compose`.
# Copy to .env and edit. Use plain KEY=value lines: no quotes, no trailing comments.

# Stack that plain `make up / down / logs / ...` controls: dev or prod.
# Set to prod on a machine where you just use the app day to day.
ENV=dev

# Host ports for the production and development stacks.
TMS_PORT=3000
TMS_DEV_PORT=3001

# Host interface the app is published on.
#   127.0.0.1  this computer only (default; TMS has no login)
#   0.0.0.0    also reachable from your LAN, e.g. your phone. Trusted networks only.
TMS_BIND=127.0.0.1

# Node.js major version used for the image.
NODE_VERSION=22
